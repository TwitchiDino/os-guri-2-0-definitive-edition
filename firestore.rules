rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /links/{linkId} {
      // 1. Qualquer pessoa pode ler um link específico pelo código (para redirecionar)
      allow get: if true;
      
      // 2. Qualquer pessoa pode incrementar o contador de cliques
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
                    && request.resource.data.clicks == resource.data.clicks + 1;
      
      // 3. Apenas usuários logados podem criar links onde o userId é igual ao seu UID
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid;
      
      // 4. Apenas o dono do link pode listar (query por userId), atualizar tudo ou deletar
      allow list, delete: if request.auth != null 
                          && resource.data.userId == request.auth.uid;
                          
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid;
    }
  }
}
